diff --git a/.github/workflows/release_ci.yml b/.github/workflows/release_ci.yml
index a2b7f8e..793cffc 100644
--- a/.github/workflows/release_ci.yml
+++ b/.github/workflows/release_ci.yml
@@ -4,6 +4,16 @@ on:
   release:
     types:
       - published
+  # [Maou] push a tag like v2.9.0 (or run manually) and the APKs are built and uploaded to a GitHub Release automatically
+  push:
+    tags:
+      - 'v*'
+  workflow_dispatch:
+    inputs:
+      tag:
+        description: 'Release tag, e.g. v2.9.0'
+        required: true
+        default: 'v2.9.0'
 
 permissions:
   contents: write
@@ -50,7 +60,7 @@ jobs:
               arm64) abi="arm64-v8a" ;;
               *) abi="$arch" ;;
             esac
-            cp "$dir/mapping.txt" "./mappings/ZalithLauncher-mapping-${version}${abi:+-$abi}.txt"
+            cp "$dir/mapping.txt" "./mappings/MaouLauncher-mapping-${version}${abi:+-$abi}.txt"
           done
 
           echo "Found $(ls ./mappings/ | wc -l) mapping file(s)"
@@ -58,7 +68,9 @@ jobs:
       - name: Upload To Release
         uses: softprops/action-gh-release@v3
         with:
-          tag_name: ${{ github.event.release.tag_name }}
+          tag_name: ${{ github.event.release.tag_name || github.event.inputs.tag || github.ref_name }}
+          name: Maou Launcher ${{ github.event.release.tag_name || github.event.inputs.tag || github.ref_name }}
+          generate_release_notes: true
           files: |
             ./apks/*.apk
             ./mappings/*.txt
diff --git a/ZalithLauncher/build.gradle.kts b/ZalithLauncher/build.gradle.kts
index ca1c622..7f2295c 100644
--- a/ZalithLauncher/build.gradle.kts
+++ b/ZalithLauncher/build.gradle.kts
@@ -115,10 +115,12 @@ android {
 
     signingConfigs {
         create("releaseBuild") {
-            storeFile = file("zalith_launcher.jks")
-            storePassword = getKeyFromLocal("STORE_PASSWORD", ".store_password.txt")
-            keyAlias = "movtery_zalith"
-            keyPassword = getKeyFromLocal("KEY_PASSWORD", ".key_password.txt")
+            // [Maou] Forks have no private keystore: sign the (fast, minified) release build with the bundled
+            // debug keystore so `assembleRelease` works without any secrets.
+            storeFile = file("zalith_launcher_debug.jks")
+            storePassword = defaultStorePassword
+            keyAlias = "movtery_zalith_debug"
+            keyPassword = defaultKeyPassword
         }
         create("debugBuild") {
             storeFile = file("zalith_launcher_debug.jks")
@@ -129,7 +131,7 @@ android {
     }
 
     defaultConfig {
-        // [Maou] ID aplikasi sendiri (namespace/package kode tetap, supaya tidak ada import yang rusak)
+        // [Maou] own package id, so it installs next to (and never replaces) the original Zalith Launcher
         applicationId = "com.maou.launcher"
         minSdk = 26
         targetSdk = 34
@@ -142,12 +144,7 @@ android {
         release {
             isMinifyEnabled = true
             isShrinkResources = true
-            // [Maou] kunci rilis asli tidak ada di repo -> pakai kunci debug supaya `assembleRelease` tetap jadi APK terpasang
-            signingConfig = if (getKeyFromLocal("STORE_PASSWORD", ".store_password.txt").isNotEmpty()) {
-                signingConfigs.getByName("releaseBuild")
-            } else {
-                signingConfigs.getByName("debugBuild")
-            }
+            signingConfig = signingConfigs.getByName("releaseBuild")
             proguardFiles(
                 getDefaultProguardFile("proguard-android-optimize.txt"),
                 "proguard-rules.pro"
@@ -155,8 +152,6 @@ android {
         }
         debug {
             isMinifyEnabled = false
-            applicationIdSuffix = ".debug"
-            versionNameSuffix = "-debug"
             signingConfig = signingConfigs.getByName("debugBuild")
         }
     }
@@ -281,7 +276,7 @@ androidComponents {
                 }
 
                 (output.getFilter(ABI)?.identifier ?: "all").let { abi ->
-                    val baseName = "$launcherName-${if (variant.buildType == "release") launcherVersionName else "Debug-$launcherVersionName"}"
+                    val baseName = "${launcherAPPName.replace(" ", "")}-${if (variant.buildType == "release") launcherVersionName else "Debug-$launcherVersionName"}"
                     output.outputFileName = if (abi == "all") "$baseName.apk" else "$baseName-$abi.apk"
                 }
             }
