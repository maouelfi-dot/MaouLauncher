           find ./artifacts -name "*.apk" -type f -exec cp {} ./apks/ \;
+          ls -la ./apks/
           echo "Found $(ls ./apks/ | wc -l) APK file(s)"
 
-      - name: Upload To Release
+      - name: Publish Release
         uses: softprops/action-gh-release@v3
         with:
-          tag_name: build-${{ github.run_number }}
-          name: Maou Launcher build ${{ github.run_number }}
+          tag_name: v${{ steps.ver.outputs.version }}
+          name: Maou Launcher ${{ steps.ver.outputs.version }}
           target_commitish: ${{ github.sha }}
-          prerelease: true
+          prerelease: false
+          make_latest: true
           generate_release_notes: true
+          body: |
+            **Pilih APK yang sesuai HP kamu:**
+            - `arm64` -> HP 64-bit (hampir semua HP sekarang). Pilih yang ini kalau ragu.
+            - `arm` -> HP 32-bit lama.
+
+            Unduh cukup SATU APK saja. Cek ukuran file hasil unduhan sama dengan yang tertera di daftar Assets sebelum dipasang.
           files: ./apks/*.apk
           fail_on_unmatched_files: true
