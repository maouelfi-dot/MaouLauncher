@@ -29,6 +34,16 @@ jobs:
     runs-on: ubuntu-latest
     if: success()
     steps:
+      - name: Checkout
+        uses: actions/checkout@v6
+
+      - name: Read version
+        id: ver
+        run: |
+          version=$(grep -E '^launcher_version_name=' ZalithLauncher/gradle.properties | cut -d= -f2 | tr -d '[:space:]')
+          echo "version=$version" >> "$GITHUB_OUTPUT"
+          echo "Versi: $version"
+
       - name: Download Files
         uses: actions/download-artifact@v8
         with:
